# Copy to .env.local and adjust. Never commit .env.local.

# Where the ROF LMS backend (ROFBACKENDTEST) listens. Next.js proxies /api/* here.
# Local development: http://localhost:3000
# Netlify: set it in Site configuration → Environment variables to the public
# HTTPS address of the backend (no trailing slash, without /api), e.g.
#   API_PROXY_TARGET=https://api.example.org
# It is read at build time, so redeploy after changing it.
API_PROXY_TARGET=http://localhost:3000
