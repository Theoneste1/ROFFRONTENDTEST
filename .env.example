# Copy to .env.local and adjust. Never commit .env.local.
# Only public addresses belong here — never backend secrets.

# Where the ROF LMS backend (ROFBACKENDTEST) listens. Next.js proxies /api/* here.
# Local development: http://localhost:3000
# Netlify: set in netlify.toml (https://rofbackendtest.onrender.com).
# It is read at build time, so rebuild/redeploy after changing it.
API_PROXY_TARGET=http://localhost:3000

# Optional: send file uploads straight to the backend instead of through the
# /api proxy (needed on Netlify, whose proxy limits uploads to about 8 MB).
# Empty = uploads use the proxy too (fine locally). When set, the backend's
# CORS_ORIGINS must contain this frontend's address.
# Netlify: set in netlify.toml (https://rofbackendtest.onrender.com).
NEXT_PUBLIC_API_UPLOAD_ORIGIN=
